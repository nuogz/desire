		"koa-favicon": "^2.1.0",
		"koa-helmet": "^6.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.5.0",
		"@stylistic/eslint-plugin-js": "^2.2.2",
		"@types/koa": "^2.15.0",
		"@types/koa-compress": "^4.0.6",
		"@types/koa-favicon": "^2.1.3",
		"@types/koa__cors": "^4.0.3",
